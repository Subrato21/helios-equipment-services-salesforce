<?xml version="1.0" encoding="UTF-8"?>
<AutoResponseRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <autoResponseRule>
        <fullName>HES Channel Acknowledgements</fullName>
        <active>true</active>
        <ruleEntry>
            <formula>AND(
  ISPICKVAL(Origin, &quot;Email&quot;),
  ISBLANK(TEXT(Junk_Reason__c)),
  NOT(ISPICKVAL(Status, &quot;Closed&quot;))
)</formula>
            <notifyCcRecipients>false</notifyCcRecipients>
            <replyToEmail>spam.zero69@gmail.com</replyToEmail>
            <senderEmail>subratochandrapal@gmail.com</senderEmail>
            <senderName>Helios Support</senderName>
            <template>unfiled$public/HES_Email_Case_Acknowledgement</template>
        </ruleEntry>
        <ruleEntry>
            <formula>AND(
  ISPICKVAL(Origin, &quot;Web&quot;),
  ISBLANK(TEXT(Junk_Reason__c)),
  NOT(ISPICKVAL(Status, &quot;Closed&quot;))
)</formula>
            <notifyCcRecipients>false</notifyCcRecipients>
            <replyToEmail>spam.zero69@gmail.com</replyToEmail>
            <senderEmail>subratochandrapal@gmail.com</senderEmail>
            <senderName>Helios Support</senderName>
            <template>unfiled$public/HES_Web_Case_Acknowledgement</template>
        </ruleEntry>
    </autoResponseRule>
</AutoResponseRules>
