<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Case_Creation_Failed</name>
        <label>Case Creation Failed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varResultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>I could not create the Case. Please contact your Salesforce administrator.</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>END_ELEMENT_4</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Case_Number_Lookup_Failed</name>
        <label>Case Number Lookup Failed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varResultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Case may have been created…</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>END_ELEMENT_6</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Created_Case_Number_Unavailable</name>
        <label>Created Case Number Unavailable</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varResultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>The Case may have been created, but I could not read its Case Number. Check Cases before trying again.</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>END_ELEMENT_1</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Prepare_Agent_Case</name>
        <label>Prepare Agent Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varNewCase.Subject</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varSubject</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewCase.Description</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varDescription</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewCase.SuppliedEmail</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varCustomerEmail</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewCase.Origin</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Agent</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewCase.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>New</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewCase.Region__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Unknown</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Type_Was_Supplied</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Reject_Invalid_Type</name>
        <label>Reject Invalid Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varResultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Please choose Technical or Billing, or leave the Case Type unspecified.</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>END_ELEMENT_1</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Returns a request for the missing information without creating a Case.</description>
        <name>Request_Missing_Case_Details</name>
        <label>Request Missing Case Details</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varResultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Please provide a short subject and the details of the service issue before I create a Case. Let this path end.</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>END_ELEMENT_1</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Return_Created_Case_Number</name>
        <label>Return Created Case Number</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varCaseNumber</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Created_Case_Number.CaseNumber</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varResultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ttCreatedCaseMessage</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>END_ELEMENT_1</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Case_Type</name>
        <label>Set Case Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varNewCase.Type</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varType</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Service_Case</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Created_Case_Is_Available</name>
        <label>Created Case Is Available</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Created_Case_Number_Unavailable</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Created_Case_Number.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Return_Created_Case_Number</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Stops Case creation until the user provides a subject and issue details.</description>
        <name>Required_Details_Present</name>
        <label>Required Details Present</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Request_Missing_Case_Details</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Missing Details</defaultConnectorLabel>
        <rules>
            <name>Complete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>frmHasRequiredDetails</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Type_Is_Allowed</targetReference>
            </connector>
            <label>Complete</label>
        </rules>
    </decisions>
    <decisions>
        <description>Accepts a blank Type for existing intake classification, or an exact Technical or Billing value.</description>
        <name>Type_Is_Allowed</name>
        <label>Type Is Allowed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Reject_Invalid_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Valid_Type</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>varType</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Technical</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Billing</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Prepare_Agent_Case</targetReference>
            </connector>
            <label>Valid Type</label>
        </rules>
    </decisions>
    <decisions>
        <name>Type_Was_Supplied</name>
        <label>Type Was Supplied</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Service_Case</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Supplied</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varType</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Case_Type</targetReference>
            </connector>
            <label>Supplied</label>
        </rules>
    </decisions>
    <description>Creates one service Case from a confirmed agent conversation and returns its Salesforce Case Number.</description>
    <ends>
        <name>END_ELEMENT_1</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_4</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_6</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <name>frmHasRequiredDetails</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  NOT(ISBLANK(TRIM({!varSubject}))),
  NOT(ISBLANK(TRIM({!varDescription})))
)</expression>
    </formulas>
    <interviewLabel>HES Agent Create Case {!$Flow.CurrentDateTime}</interviewLabel>
    <label>HES Agent Create Case</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Service_Case</name>
        <label>Create Service Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Created_Case_Number</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Case_Creation_Failed</targetReference>
        </faultConnector>
        <inputReference>varNewCase</inputReference>
    </recordCreates>
    <recordLookups>
        <description>Reads the Case Number Salesforce assigned to the Case just created</description>
        <name>Get_Created_Case_Number</name>
        <label>Get Created Case Number</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Created_Case_Is_Available</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Case_Number_Lookup_Failed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varNewCase.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>UserMode</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Required_Details_Present</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>ttCreatedCaseMessage</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;code&gt;Case {!varCaseNumber} was created.&lt;/code&gt; Insert &lt;code&gt;varCaseNumber&lt;/code&gt;&lt;/p&gt;</text>
    </textTemplates>
    <variables>
        <description>Actual Case Number returned after the Case is created.</description>
        <name>varCaseNumber</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>Customer email address if the user supplies one.</description>
        <name>varCustomerEmail</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Details of the service issue. Required before creating a Case.</description>
        <name>varDescription</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varNewCase</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Case</objectType>
    </variables>
    <variables>
        <description>Safe success or failure message for the assistant to show.</description>
        <name>varResultMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>Short description of the service issue. Required before creating a Case</description>
        <name>varSubject</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Case Type when known. Use exactly Technical or Billing.</description>
        <name>varType</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
