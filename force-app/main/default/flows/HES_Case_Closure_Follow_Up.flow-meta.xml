                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case_Contact.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Customer_Email_from_Contact</targetReference>
            </connector>
            <label>Use Contact Email</label>
        </rules>
    </decisions>
    <decisions>
        <description>Sends feedback only when a Contact or supplied email address is available.</description>
        <name>Customer_Email_Available</name>
        <label>Customer Email Available</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>END_ELEMENT_1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Send_Feedback</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
