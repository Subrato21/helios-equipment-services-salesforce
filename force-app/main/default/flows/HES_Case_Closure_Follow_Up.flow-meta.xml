    <status>Active</status>
    <textTemplates>
        <description>Plain-text satisfaction request sent after genuine Case closure.</description>
        <name>ClosureFeedbackBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Thank you for choosing Helios Equipment Services.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Case {!$Record.CaseNumber} is now closed.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Please reply and tell us how satisfied you were with the service.&lt;/p&gt;</text>
    </textTemplates>
