        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Equipment__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Last_Service_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
