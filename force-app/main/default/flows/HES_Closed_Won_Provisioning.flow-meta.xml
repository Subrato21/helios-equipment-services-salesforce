            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Sold_Lines</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Require_Opportunity_Product</targetReference>
            </connector>
            <label>No Lines</label>
        </rules>
