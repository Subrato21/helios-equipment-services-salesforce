            <targetReference>Has_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome: New Win</defaultConnectorLabel>
        <rules>
            <name>Plan_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Win_Plan.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
